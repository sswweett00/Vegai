# Benchmark inputs are bounded, independently split, and explicitly validated.
if(NOT DEFINED BENCH OR NOT DEFINED FIXTURE OR NOT DEFINED WORK_ROOT)
  message(FATAL_ERROR "BENCH, FIXTURE and WORK_ROOT are required")
endif()
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef nonce)
set(work "${WORK_ROOT}/native-quality-${nonce}")
file(MAKE_DIRECTORY "${work}")
file(WRITE "${work}/train.txt" "abcdefghijklmnop\n")
file(WRITE "${work}/copy.txt" "abcdefghijklmnop\n")
file(WRITE "${work}/held.txt" "uvwxyz\n")
file(WRITE "${work}/short.txt" "abc")
execute_process(COMMAND "${FIXTURE}" corpus "${work}/nul.bin" 6 RESULT_VARIABLE result ERROR_VARIABLE err)
if(NOT "${result}" STREQUAL "0")
  message(FATAL_ERROR "could not create byte fixture: ${result}: ${err}")
endif()
function(expect_failure expected)
  execute_process(COMMAND "${BENCH}" ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${result}" MATCHES "^[0-9]+$" OR "${result}" STREQUAL "0" OR NOT err MATCHES "${expected}")
    message(FATAL_ERROR "benchmark did not reject ${ARGN}: ${result}: ${out}: ${err}")
  endif()
endfunction()
expect_failure("paths must differ" "${work}/train.txt" "${work}/train.txt" 4)
expect_failure("byte-identical" "${work}/train.txt" "${work}/copy.txt" 4)
expect_failure("integer in" "${work}/train.txt" "${work}/held.txt" 0)
expect_failure("integer in" "${work}/train.txt" "${work}/held.txt" -1)
expect_failure("integer in" "${work}/train.txt" "${work}/held.txt" 4 0)
expect_failure("shape must" "${work}/train.txt" "${work}/held.txt" 4 3000 unknown)
expect_failure("too short" "${work}/short.txt" "${work}/held.txt" 4)
expect_failure("NUL is unsupported" "${work}/nul.bin" "${work}/held.txt" 4)
expect_failure("cannot open" "${work}/missing.txt" "${work}/held.txt" 4)
# Do not benchmark the trimmed spelling of a distinct caller-supplied path.
expect_failure("invalid train path" "${work}/train.txt " "${work}/held.txt" 4)
expect_failure("invalid held-out path" "${work}/train.txt" "${work}/held.txt " 4)
string(REPEAT "x" 1100 overlong_path)
expect_failure("invalid train path" "${overlong_path}" "${work}/held.txt" 4)
if(NOT WIN32)
  string(ASCII 255 invalid_path_byte)
  expect_failure("invalid train path" "${work}/train${invalid_path_byte}" "${work}/held.txt" 4)
  expect_failure("invalid held-out path" "${work}/train.txt" "${work}/held${invalid_path_byte}" 4)
endif()
if(UNIX AND EXISTS "/dev/null")
  expect_failure("size invalid" "/dev/null" "${work}/held.txt" 4)
endif()
file(REMOVE_RECURSE "${work}")
message(STATUS "native quality benchmark rejects invalid and overlapping inputs")
