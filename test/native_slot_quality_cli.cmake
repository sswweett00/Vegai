# SPDX-License-Identifier: MIT
# Exercise two independently reset held-outs, equal budgets, and bounded inputs.
if(NOT DEFINED BENCH OR NOT DEFINED FIXTURE OR NOT DEFINED WORK_ROOT)
  message(FATAL_ERROR "BENCH, FIXTURE and WORK_ROOT are required")
endif()
# CMake writes native line endings (CRLF on Windows); the native helper
# writes the exact bytes the contract asserts.
include("${CMAKE_CURRENT_LIST_DIR}/native_exact_text.cmake")
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef nonce)
set(work "${WORK_ROOT}/native-slot-quality-${nonce}")
file(MAKE_DIRECTORY "${work}")
native_write_text("${work}/train.txt" "abcdefghijklmnop\n")
native_write_text("${work}/copy.txt" "abcdefghijklmnop\n")
native_write_text("${work}/held-a.txt" "uvwxyz\n")
native_write_text("${work}/held-b.txt" "different held-out\n")
native_write_text("${work}/short.txt" "abc")
execute_process(COMMAND "${FIXTURE}" corpus "${work}/nul-train.bin" 6 RESULT_VARIABLE result ERROR_VARIABLE err)
if(NOT "${result}" STREQUAL "0")
  message(FATAL_ERROR "cannot create NUL/FF training fixture: ${result}: ${err}")
endif()
configure_file("${work}/nul-train.bin" "${work}/nul-held.bin" COPYONLY)
file(APPEND "${work}/nul-held.bin" "B")

# Both V6 and V7 support the same byte mapping, including NUL -> token 256.
execute_process(COMMAND "${BENCH}" "${work}/nul-train.bin" "${work}/nul-held.bin" "${work}/held-b.txt" 4 6000 small
  RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT "${result}" STREQUAL "0" OR NOT out MATCHES "schema=vegai-context-slot-quality/v1" OR
   NOT out MATCHES "train_predictions=32" OR NOT out MATCHES "heldout_a_predictions=33" OR
   NOT out MATCHES "both_learning_rate_micros=6000" OR NOT out MATCHES "median_delta_a=" OR
   NOT out MATCHES "median_delta_b=" OR NOT out MATCHES "median_time_ratio=")
  message(FATAL_ERROR "two-heldout V6/V7 benchmark failed: ${result}: ${out}: ${err}")
endif()
string(REGEX MATCHALL "(^|\n)(21|42|73|101|137),(12|21),8," seed_rows "${out}")
list(LENGTH seed_rows row_count)
if(NOT row_count EQUAL 5)
  message(FATAL_ERROR "benchmark must report five paired, eight-update runs: ${out}")
endif()

function(expect_failure expected)
  execute_process(COMMAND "${BENCH}" ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${result}" MATCHES "^-?[0-9]+$" OR "${result}" STREQUAL "0" OR NOT err MATCHES "${expected}")
    message(FATAL_ERROR "benchmark failed to reject ${ARGN}: ${result}: ${out}: ${err}")
  endif()
endfunction()
expect_failure("paths must differ" "${work}/train.txt" "${work}/train.txt" "${work}/held-b.txt" 4)
expect_failure("paths must differ" "${work}/train.txt" "${work}/held-a.txt" "${work}/held-a.txt" 4)
expect_failure("must differ byte-for-byte" "${work}/train.txt" "${work}/copy.txt" "${work}/held-b.txt" 4)
expect_failure("invalid chunk" "${work}/train.txt" "${work}/held-a.txt" "${work}/held-b.txt" 0)
expect_failure("invalid learning rate" "${work}/train.txt" "${work}/held-a.txt" "${work}/held-b.txt" 4 0)
expect_failure("shape must" "${work}/train.txt" "${work}/held-a.txt" "${work}/held-b.txt" 4 6000 unknown)
expect_failure("too short" "${work}/short.txt" "${work}/held-a.txt" "${work}/held-b.txt" 4)
expect_failure("cannot open" "${work}/missing.txt" "${work}/held-a.txt" "${work}/held-b.txt" 4)
expect_failure("invalid or overlong argument" "${work}/train.txt " "${work}/held-a.txt" "${work}/held-b.txt" 4)
string(REPEAT "x" 1100 overlong)
expect_failure("invalid or overlong argument" "${overlong}" "${work}/held-a.txt" "${work}/held-b.txt" 4)
if(NOT WIN32)
  string(ASCII 255 invalid_path_byte)
  expect_failure("invalid or overlong argument" "${work}/train${invalid_path_byte}" "${work}/held-a.txt" "${work}/held-b.txt" 4)
endif()
if(UNIX AND EXISTS "/dev/null")
  expect_failure("size invalid" "/dev/null" "${work}/held-a.txt" "${work}/held-b.txt" 4)
endif()
file(REMOVE_RECURSE "${work}")
message(STATUS "native slot benchmark validates inputs and scores two independent held-outs")
