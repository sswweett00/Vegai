# Python-free integration: byte fidelity, input bounds and non-destructive errors.
if(NOT DEFINED EXTRACT OR NOT DEFINED WORK_ROOT OR "${WORK_ROOT}" STREQUAL "")
  message(FATAL_ERROR "EXTRACT and WORK_ROOT are required")
endif()
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef nonce)
set(work "${WORK_ROOT}/native-ud-text-${nonce}")
file(MAKE_DIRECTORY "${work}")

function(run_extract expected_exit)
  execute_process(COMMAND "${EXTRACT}" ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
  if(NOT "${result}" STREQUAL "${expected_exit}")
    message(FATAL_ERROR "extract returned ${result}, expected ${expected_exit}: ${out}: ${err}")
  endif()
  if(NOT "${expected_exit}" STREQUAL "0" AND NOT "${out}" STREQUAL "")
    message(FATAL_ERROR "failure must not emit a successful-looking report: ${out}")
  endif()
  set(report "${out}" PARENT_SCOPE)
endfunction()

function(expect_no_file path)
  if(EXISTS "${path}")
    message(FATAL_ERROR "failed extraction left an output: ${path}")
  endif()
endfunction()

run_extract(2)
set(source "${work}/sample input.conllu")
file(WRITE "${source}" "# sent_id = first\r\n# text = İlk satır  \r\n1\tignored\r\n")
file(APPEND "${source}" "# text = İkinci\tmetin\n# text = üçüncü")
file(SHA256 "${source}" source_hash)
run_extract(0 "${source}" "${work}/two.txt" 2)
file(WRITE "${work}/expected-two.txt" "İlk satır  \nİkinci\tmetin\n")
file(SHA256 "${work}/two.txt" actual_hash)
file(SHA256 "${work}/expected-two.txt" expected_hash)
if(NOT actual_hash STREQUAL expected_hash)
  message(FATAL_ERROR "UTF-8, spaces, tabs or CRLF normalization changed")
endif()
string(JSON schema ERROR_VARIABLE problem GET "${report}" schema)
if(NOT problem STREQUAL "NOTFOUND" OR NOT schema STREQUAL "vegai-ud-text/v1")
  message(FATAL_ERROR "bad extraction report: ${report}")
endif()
string(JSON records ERROR_VARIABLE problem GET "${report}" records)
if(NOT problem STREQUAL "NOTFOUND" OR NOT records STREQUAL "2")
  message(FATAL_ERROR "incorrect record count: ${report}")
endif()
string(JSON reported_bytes ERROR_VARIABLE problem GET "${report}" output_bytes)
file(SIZE "${work}/two.txt" actual_bytes)
if(NOT problem STREQUAL "NOTFOUND" OR NOT "${reported_bytes}" STREQUAL "${actual_bytes}")
  message(FATAL_ERROR "incorrect output byte count: ${report}")
endif()
run_extract(0 "${source}" "${work}/three.txt" 3)
file(WRITE "${work}/expected-three.txt" "İlk satır  \nİkinci\tmetin\nüçüncü\n")
file(SHA256 "${work}/three.txt" actual_hash)
file(SHA256 "${work}/expected-three.txt" expected_hash)
if(NOT actual_hash STREQUAL expected_hash)
  message(FATAL_ERROR "final unterminated source record was not extracted exactly")
endif()

# A limit may stop before invalid later records; only extracted text is UTF-8
# validated. A request that reaches the invalid record must clean up its output.
file(WRITE "${work}/empty-later.conllu" "# text = valid\n# text = \n")
run_extract(0 "${work}/empty-later.conllu" "${work}/first-only.txt" 1)
run_extract(2 "${work}/empty-later.conllu" "${work}/empty-output.txt" 2)
expect_no_file("${work}/empty-output.txt")
run_extract(2 "${source}" "${work}/too-many.txt" 4)
expect_no_file("${work}/too-many.txt")
run_extract(2 "${source}" "${work}/zero.txt" 0)
expect_no_file("${work}/zero.txt")
run_extract(2 "${source}" "${work}/bad-number.txt" 1e3)
expect_no_file("${work}/bad-number.txt")
run_extract(2 "${source}" "${work}/too-large.txt" 10000001)
expect_no_file("${work}/too-large.txt")
run_extract(2 "${source}" "${work}/overflow.txt" 9999999999999999999999999999999)
expect_no_file("${work}/overflow.txt")
run_extract(2 "${work}/missing.conllu" "${work}/missing-output.txt" 1)
expect_no_file("${work}/missing-output.txt")
file(WRITE "${work}/zero-byte.conllu" "")
run_extract(2 "${work}/zero-byte.conllu" "${work}/empty-input-output.txt" 1)
expect_no_file("${work}/empty-input-output.txt")

# Existing outputs, including an input named as its own output, must survive.
file(WRITE "${work}/sentinel.txt" "do not replace\n")
run_extract(2 "${source}" "${work}/sentinel.txt" 1)
file(READ "${work}/sentinel.txt" preserved)
if(NOT preserved STREQUAL "do not replace\n")
  message(FATAL_ERROR "existing output was replaced")
endif()
run_extract(2 "${source}" "${source}" 1)
file(SHA256 "${source}" source_hash_after)
if(NOT source_hash STREQUAL source_hash_after)
  message(FATAL_ERROR "input was modified by self-aliasing output")
endif()
foreach(kind IN ITEMS hard symbolic)
  set(link "${work}/${kind}-alias.conllu")
  if(kind STREQUAL "symbolic")
    file(CREATE_LINK "${source}" "${link}" SYMBOLIC RESULT link_result)
  else()
    file(CREATE_LINK "${source}" "${link}" RESULT link_result)
  endif()
  # Some runners prohibit link creation. Skip, rather than claim support.
  if("${link_result}" STREQUAL "0")
    run_extract(2 "${source}" "${link}" 1)
    file(SHA256 "${source}" source_hash_after)
    if(NOT source_hash STREQUAL source_hash_after)
      message(FATAL_ERROR "${kind} alias modified the input")
    endif()
  endif()
endforeach()

# On Linux a FIFO normally reports size zero and must not block awaiting a writer.
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
  find_program(MKFIFO_EXECUTABLE mkfifo)
  if(MKFIFO_EXECUTABLE)
    execute_process(COMMAND "${MKFIFO_EXECUTABLE}" "${work}/fifo" RESULT_VARIABLE fifo_result)
    if("${fifo_result}" STREQUAL "0")
      run_extract(2 "${work}/fifo" "${work}/fifo-output.txt" 1)
      expect_no_file("${work}/fifo-output.txt")
    endif()
  endif()
endif()

# The NUL fixture is binary. Generate the invalid UTF-8 byte at runtime: a
# text-oriented checkout/patch transport can silently turn a stored 0xFF into
# the valid replacement character U+FFFD, which would invalidate this test.
run_extract(2 "${CMAKE_CURRENT_LIST_DIR}/fixtures/ud-invalid-nul.conllu" "${work}/nul.txt" 1)
expect_no_file("${work}/nul.txt")
string(ASCII 255 invalid_byte)
file(WRITE "${work}/invalid-utf8.conllu" "# text = bad${invalid_byte}text\n")
run_extract(2 "${work}/invalid-utf8.conllu" "${work}/utf8.txt" 1)
expect_no_file("${work}/utf8.txt")
# U+FFFD is valid UTF-8 and must not be mistaken for an invalid input byte.
file(WRITE "${work}/replacement.conllu" "# text = bad�text\n")
run_extract(0 "${work}/replacement.conllu" "${work}/replacement.txt" 1)
string(REPEAT "x" 65527 exact_payload)
file(WRITE "${work}/exact-limit.conllu" "# text = ${exact_payload}\n")
run_extract(0 "${work}/exact-limit.conllu" "${work}/exact-limit.txt" 1)
file(SIZE "${work}/exact-limit.txt" exact_size)
if(NOT exact_size EQUAL 65528)
  message(FATAL_ERROR "65536-byte input record limit is not inclusive")
endif()
string(REPEAT "x" 65537 long_record)
file(WRITE "${work}/oversized.conllu" "# text = valid\n${long_record}\n# text = later\n")
run_extract(2 "${work}/oversized.conllu" "${work}/oversized-output.txt" 2)
expect_no_file("${work}/oversized-output.txt")

file(REMOVE_RECURSE "${work}")
message(STATUS "Native UD text extraction contract passed")
