# Python-free integration, bounds, collision, and byte-fidelity checks.
if(NOT DEFINED OVERLAP OR NOT DEFINED FIXTURE OR NOT DEFINED WORK_ROOT)
  message(FATAL_ERROR "OVERLAP, FIXTURE and WORK_ROOT are required")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/native_exact_text.cmake")
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef nonce)
set(work "${WORK_ROOT}/native-overlap-${nonce}")
file(MAKE_DIRECTORY "${work}")

function(run_check expected_exit expected_error)
  execute_process(COMMAND "${OVERLAP}" ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${result}" STREQUAL "${expected_exit}")
    message(FATAL_ERROR "overlap returned ${result}, expected ${expected_exit}: ${out}: ${err}")
  endif()
  if(NOT "${expected_error}" STREQUAL "" AND NOT err MATCHES "${expected_error}")
    message(FATAL_ERROR "overlap omitted expected diagnostic ${expected_error}: ${out}: ${err}")
  endif()
  if("${expected_exit}" STREQUAL "2" AND NOT "${out}" STREQUAL "")
    message(FATAL_ERROR "failure must not emit a successful-looking report: ${out}")
  endif()
  set(report "${out}" PARENT_SCOPE)
endfunction()

function(expect_field name expected)
  string(JSON actual ERROR_VARIABLE problem GET "${report}" "${name}")
  if(NOT problem STREQUAL "NOTFOUND" OR NOT "${actual}" STREQUAL "${expected}")
    message(FATAL_ERROR "field ${name}: expected ${expected}, got ${actual} (${problem}): ${report}")
  endif()
endfunction()

run_check(2 "usage")
# CMake file(WRITE) rewrites LF as CRLF on Windows; contracts that assert
# exact bytes use the compiled byte-exact fixture writer instead.
native_write_text("${work}/train" "AAAAAAAAAA\nalpha \nTürk\nlast")
native_write_text("${work}/held" "CAAAAAAAA@\nalpha\nFARK\n")
# The first records have the same full 64-bit hash, but different bytes; a
# hash-only index would falsely claim overlap. Trailing space is significant.
run_check(0 "" "${work}/train" "${work}/held")
expect_field(schema "vegai-exact-record-overlap/v1")
expect_field(train_records 4)
expect_field(heldout_records 3)
expect_field(heldout_unique_records 3)
expect_field(overlapping_train_records 0)
expect_field(overlapping_heldout_unique_records 0)
expect_field(first_train_line 0)
expect_field(first_heldout_line 0)
expect_field(overlap OFF)
native_write_text("${work}/collision-train" "AAAAAAAAAA\n")
native_write_text("${work}/collision-held" "AAAAAAAAAA\nCAAAAAAAA@\n")
run_check(1 "" "${work}/collision-train" "${work}/collision-held")
expect_field(overlapping_train_records 1)
expect_field(first_heldout_line 1)
# These valid ASCII-octet records hash to 0, 1, int64's maximum/minimum,
# and all-one bits. Signed MODULO of the minimum can trap in checked GNU.
string(ASCII 92 backslash_byte)
string(ASCII 1 ctrl1)
string(ASCII 4 ctrl4)
string(ASCII 6 ctrl6)
string(ASCII 11 ctrl11)
string(ASCII 25 ctrl25)
set(extreme_records "${backslash_byte}7tf?NyI${ctrl4}tZd\n${backslash_byte}7vf?NyI${ctrl4}tZd\n")
string(APPEND extreme_records "${ctrl1}rF${ctrl25}@1${ctrl6}6{%GB\n${backslash_byte}7uf?NyI${ctrl4}tZd\n")
string(APPEND extreme_records "#H${ctrl11}${ctrl25}@1${ctrl6}6{4Zd\n")
native_write_text("${work}/extreme-hashes" "${extreme_records}")
run_check(1 "" "${work}/extreme-hashes" "${work}/extreme-hashes")
expect_field(overlapping_train_records 5)
expect_field(overlap ON)

native_write_text("${work}/train" "\nDUP\nother\nDUP\nCRmatch\r\n")
native_write_text("${work}/held" "first\nDUP\nDUP\nCRmatch\n")
file(SHA256 "${work}/train" before_hash)
run_check(1 "" "${work}/train" "${work}/held")
expect_field(train_records 4)
expect_field(heldout_records 4)
expect_field(heldout_unique_records 3)
expect_field(overlapping_train_records 3)
expect_field(overlapping_heldout_unique_records 2)
expect_field(first_train_line 2)
expect_field(first_heldout_line 2)
expect_field(overlap ON)
# The check never writes either input, even on an overlap.
file(SHA256 "${work}/train" after_hash)
if(NOT before_hash STREQUAL after_hash)
  message(FATAL_ERROR "train input changed")
endif()

# A full-size raw record is valid, including when a later record straddles the
# 64 KiB read-ahead buffer; 4097 bytes must instead fail closed.
set(max_record_tokens "")
foreach(index RANGE 1 20)
  list(APPEND max_record_tokens "78*4096" "0a")
endforeach()
native_write_hex("${work}/train" ${max_record_tokens})
native_write_hex("${work}/held" "78*4096" "0a")
run_check(1 "" "${work}/train" "${work}/held")
expect_field(train_records 20)
expect_field(overlapping_train_records 20)
expect_field(overlapping_heldout_unique_records 1)
native_write_hex("${work}/too-long" "78*4097" "0a")
run_check(2 "record exceeds 4096" "${work}/train" "${work}/too-long")
run_check(2 "record exceeds 4096" "${work}/too-long" "${work}/held")

native_write_text("${work}/ok" "valid\n")
file(MAKE_DIRECTORY "${work}/path with spaces")
native_write_text("${work}/path with spaces/train data.txt" "first\n")
native_write_text("${work}/path with spaces/held data.txt" "second\n")
run_check(0 "" "${work}/path with spaces/train data.txt" "${work}/path with spaces/held data.txt")
native_write_hex("${work}/empty")
native_write_text("${work}/blank" "\n\r\n")
run_check(2 "empty or unknown-size" "${work}/ok" "${work}/empty")
run_check(2 "no nonempty records" "${work}/blank" "${work}/ok")
run_check(2 "no nonempty records" "${work}/ok" "${work}/blank")
run_check(2 "cannot open" "${work}/missing" "${work}/ok")
if(UNIX)
  find_program(MKFIFO_EXECUTABLE mkfifo)
  if(MKFIFO_EXECUTABLE)
    execute_process(COMMAND "${MKFIFO_EXECUTABLE}" "${work}/fifo" RESULT_VARIABLE fifo_result)
    if(NOT "${fifo_result}" STREQUAL "0")
      message(FATAL_ERROR "cannot create FIFO fixture")
    endif()
    # No writer is attached: OPEN before the size preflight would block.
    execute_process(COMMAND "${OVERLAP}" "${work}/ok" "${work}/fifo"
                    RESULT_VARIABLE fifo_result OUTPUT_VARIABLE fifo_out ERROR_VARIABLE fifo_err TIMEOUT 5)
    if(NOT "${fifo_result}" STREQUAL "2" OR NOT fifo_err MATCHES "empty or unknown-size" OR NOT fifo_out STREQUAL "")
      message(FATAL_ERROR "FIFO was not rejected before OPEN: ${fifo_result}: ${fifo_out}: ${fifo_err}")
    endif()
  endif()
endif()
run_check(2 "invalid train path" "${work}/ok " "${work}/held")
run_check(2 "invalid held-out path" "${work}/ok" "${work}/held ")
string(REPEAT "p" 4500 long_path)
run_check(2 "invalid train path" "${long_path}" "${work}/ok")
if(NOT WIN32)
  string(ASCII 255 bad_argument)
  run_check(2 "invalid train path" "${work}/bad${bad_argument}" "${work}/ok")
endif()
native_write_hex("${work}/invalid-utf8" "61" "ff" "0a")
run_check(2 "invalid UTF-8" "${work}/invalid-utf8" "${work}/ok")
run_check(2 "invalid UTF-8" "${work}/ok" "${work}/invalid-utf8")
# A prior overlap does not turn an incomplete or malformed scan into a report.
string(HEX "valid\na" bad_prefix)
native_write_hex("${work}/bad-after-match" "${bad_prefix}" "ff" "0a")
run_check(2 "invalid UTF-8" "${work}/bad-after-match" "${work}/ok")
execute_process(COMMAND "${FIXTURE}" corpus "${work}/nul-record" 6 RESULT_VARIABLE fixture_result)
if(NOT "${fixture_result}" STREQUAL "0")
  message(FATAL_ERROR "could not make NUL fixture")
endif()
run_check(2 "NUL byte" "${work}/ok" "${work}/nul-record")
run_check(2 "NUL byte" "${work}/nul-record" "${work}/ok")

# Each exact limit is accepted; the next record must fail closed instead of
# being dropped and producing a false disjoint report.
foreach(kind IN ITEMS overlap-collisions-exact overlap-unique-exact overlap-bytes-exact)
  execute_process(COMMAND "${FIXTURE}" "${kind}" "${work}/${kind}" 6 RESULT_VARIABLE fixture_result)
  if(NOT "${fixture_result}" STREQUAL "0")
    message(FATAL_ERROR "could not make ${kind} fixture")
  endif()
  run_check(0 "" "${work}/ok" "${work}/${kind}")
  if(kind STREQUAL "overlap-collisions-exact")
    expect_field(heldout_unique_records 1024)
  elseif(kind STREQUAL "overlap-unique-exact")
    expect_field(heldout_unique_records 100000)
  else()
    expect_field(heldout_unique_records 16384)
  endif()
  expect_field(overlap OFF)
  file(REMOVE "${work}/${kind}")
endforeach()
foreach(kind IN ITEMS overlap-collisions overlap-unique overlap-bytes)
  execute_process(COMMAND "${FIXTURE}" "${kind}" "${work}/${kind}" 6 RESULT_VARIABLE fixture_result)
  if(NOT "${fixture_result}" STREQUAL "0")
    message(FATAL_ERROR "could not make ${kind} fixture")
  endif()
endforeach()
run_check(2 "hash bucket limit exceeded" "${work}/ok" "${work}/overlap-collisions")
run_check(2 "held-out unique record limit exceeded" "${work}/ok" "${work}/overlap-unique")
run_check(2 "held-out byte limit exceeded" "${work}/ok" "${work}/overlap-bytes")
file(REMOVE_RECURSE "${work}")
message(STATUS "native exact-record overlap, byte fidelity and fail-closed bounds passed")
