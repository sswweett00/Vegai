# The opt-in short Turkish profile must be only an LR choice, with exactly the
# same training/checkpoint as an explicit rate and no change to old defaults.
if(NOT DEFINED ENGINE OR NOT DEFINED WORK_ROOT)
  message(FATAL_ERROR "ENGINE and WORK_ROOT are required")
endif()
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef nonce)
set(work "${WORK_ROOT}/native-natural-profile-${nonce}")
file(MAKE_DIRECTORY "${work}")
string(REPEAT "A Turkish byte training record for a bounded profile.\n" 60 corpus)
file(WRITE "${work}/train.txt" "${corpus}")
foreach(arm IN ITEMS profile explicit)
  if(arm STREQUAL "profile")
    set(extra --training-profile turkish-short)
  else()
    set(extra --lr 0.012)
  endif()
  execute_process(COMMAND "${ENGINE}" train --corpus "${work}/train.txt" --checkpoint "${work}/${arm}.vgfb"
    --max-updates 2 --seed 42 --progress-every 0 ${extra}
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "${arm} fresh training failed: ${result}: ${out}: ${err}")
  endif()
  string(LENGTH "CORPUS_TRAIN_JSON " prefix)
  string(SUBSTRING "${out}" ${prefix} -1 json)
  string(JSON lr ERROR_VARIABLE json_error GET "${json}" learning_rate)
  string(JSON applied GET "${json}" training_profile_applied)
  string(JSON tokens GET "${json}" session_tokens)
  string(JSON updates GET "${json}" session_updates)
  string(JSON time_type TYPE "${json}" session_seconds_precise)
  string(JSON rate_type TYPE "${json}" session_tokens_per_second_precise)
  if(NOT json_error STREQUAL "NOTFOUND" OR NOT tokens EQUAL 1024 OR NOT updates EQUAL 2)
    message(FATAL_ERROR "${arm} telemetry or budget incorrect: ${out}: ${json_error}")
  endif()
  if(NOT time_type STREQUAL rate_type OR (NOT time_type STREQUAL "NUMBER" AND NOT time_type STREQUAL "NULL"))
    message(FATAL_ERROR "precise elapsed time and throughput must both be numbers or both null: ${out}")
  endif()
  if(time_type STREQUAL "NUMBER")
    string(JSON precise_seconds GET "${json}" session_seconds_precise)
    string(JSON precise_rate GET "${json}" session_tokens_per_second_precise)
    if(NOT precise_seconds GREATER 0 OR NOT precise_rate GREATER 0)
      message(FATAL_ERROR "precise elapsed time/rate must be positive for actual training: ${out}")
    endif()
  endif()
  if(arm STREQUAL "profile")
    if(NOT applied)
      message(FATAL_ERROR "profile was not reported as applied: ${out}")
    endif()
    set(profile_lr "${lr}")
  else()
    if(applied OR NOT lr STREQUAL profile_lr)
      message(FATAL_ERROR "explicit LR or profile telemetry mismatch: ${out}")
    endif()
  endif()
endforeach()
file(SHA256 "${work}/profile.vgfb" profile_hash)
file(SHA256 "${work}/explicit.vgfb" explicit_hash)
if(NOT profile_hash STREQUAL explicit_hash)
  message(FATAL_ERROR "profile changed training beyond its explicit learning rate")
endif()

execute_process(COMMAND "${ENGINE}" train --corpus "${work}/train.txt" --checkpoint "${work}/resumed.vgfb"
  --resume "${work}/profile.vgfb" --start-byte 1024 --max-updates 3 --progress-every 0
  RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT "${result}" STREQUAL "0")
  message(FATAL_ERROR "profile checkpoint resume failed: ${result}: ${out}: ${err}")
endif()
string(SUBSTRING "${out}" ${prefix} -1 json)
string(JSON resumed_lr ERROR_VARIABLE json_error GET "${json}" learning_rate)
string(JSON applied GET "${json}" training_profile_applied)
string(JSON updates GET "${json}" updates)
if(NOT json_error STREQUAL "NOTFOUND" OR NOT resumed_lr STREQUAL profile_lr OR applied OR NOT updates EQUAL 3)
  message(FATAL_ERROR "resume failed to retain stored profile LR: ${out}: ${json_error}")
endif()

file(WRITE "${work}/sentinel.vgfb" "do not overwrite")
function(expect_failure expected)
  execute_process(COMMAND "${ENGINE}" ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${result}" MATCHES "^-?[0-9]+$" OR "${result}" STREQUAL "0" OR NOT err MATCHES "${expected}")
    message(FATAL_ERROR "profile did not reject ${ARGN}: ${result}: ${out}: ${err}")
  endif()
  file(READ "${work}/sentinel.vgfb" sentinel)
  if(NOT sentinel STREQUAL "do not overwrite")
    message(FATAL_ERROR "rejected profile request overwrote checkpoint")
  endif()
endfunction()
set(base train --corpus "${work}/train.txt" --checkpoint "${work}/sentinel.vgfb" --training-profile turkish-short)
expect_failure("--max-updates in 1..163" ${base})
expect_failure("--max-updates in 1..163" ${base} --max-updates 164)
expect_failure("cannot be combined with --lr" ${base} --max-updates 1 --lr 0.012)
expect_failure("requires training rule 6" ${base} --max-updates 1 --training-rule 7)
expect_failure("requires the default shape" ${base} --max-updates 1 --width 16)
expect_failure("requires the default shape" ${base} --max-updates 1 --train-chunk-tokens 32)
expect_failure("requires the default shape" ${base} --max-updates 1 --reset-every 512)
expect_failure("only valid for fresh training" ${base} --max-updates 1 --resume "${work}/profile.vgfb")
expect_failure("only valid for fresh training" ask --training-profile turkish-short)
expect_failure("must be turkish-short" train --training-profile unknown)
file(REMOVE_RECURSE "${work}")
message(STATUS "short Turkish profile matches explicit LR and preserves resume semantics")
