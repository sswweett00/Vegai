# SPDX-License-Identifier: MIT
# Equal-rate identity, bounded input and independent cold-record accounting.
if(NOT DEFINED BENCH OR NOT DEFINED FIXTURE OR NOT DEFINED WORK_ROOT)
  message(FATAL_ERROR "BENCH, FIXTURE and WORK_ROOT are required")
endif()
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef nonce)
set(work "${WORK_ROOT}/native-natural-quality-${nonce}")
file(MAKE_DIRECTORY "${work}")
file(WRITE "${work}/train.txt" "abcdefghijklmnop\n")
file(WRITE "${work}/copy.txt" "abcdefghijklmnop\n")
file(WRITE "${work}/held-a.txt" "uvwxyz\n")
file(WRITE "${work}/held-b.txt" "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMN\nxy\n")
file(WRITE "${work}/no-transitions.txt" "x\ny\n")
file(WRITE "${work}/short.txt" "abc")

execute_process(COMMAND "${BENCH}" "${work}/train.txt" "${work}/held-a.txt" "${work}/held-b.txt" 4 6000 small 6000
  RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT "${result}" STREQUAL "0" OR NOT out MATCHES "schema=vegai-natural-lr-quality/v1" OR
   NOT out MATCHES "train_predictions=16" OR NOT out MATCHES "heldout_a_predictions=6" OR
   NOT out MATCHES "base_learning_rate_micros=6000 candidate_learning_rate_micros=6000" OR
   NOT out MATCHES "median_cold_a=" OR NOT out MATCHES "median_prefix_a=" OR
   NOT out MATCHES "improved_a=0 improved_b=0 improved_cold_a=0 improved_cold_b=0 improved_prefix_a=0 improved_prefix_b=0" OR
   NOT out MATCHES "a_cold_count=5 b_cold_count=40 a_prefix_count=5 b_prefix_count=33")
  message(FATAL_ERROR "equal-rate natural benchmark failed: ${result}: ${out}: ${err}")
endif()
string(REGEX MATCHALL "(21|42|73|101|137),(12|21),4,[^\n]+" seed_rows "${out}")
list(LENGTH seed_rows row_count)
if(NOT row_count EQUAL 5)
  message(FATAL_ERROR "benchmark must report five paired, four-update runs: ${out}")
endif()
foreach(row IN LISTS seed_rows)
  string(REPLACE "," ";" fields "${row}")
  list(LENGTH fields field_count)
  if(NOT field_count EQUAL 20)
    message(FATAL_ERROR "unexpected number of benchmark fields: ${row}")
  endif()
  foreach(pair IN ITEMS "3;4" "6;7" "9;10" "11;12" "13;14" "15;16")
    list(GET pair 0 left_index)
    list(GET pair 1 right_index)
    list(GET fields ${left_index} left)
    list(GET fields ${right_index} right)
    string(STRIP "${left}" left)
    string(STRIP "${right}" right)
    if(NOT left STREQUAL right)
      message(FATAL_ERROR "equal learning rates must give identical NLLs: ${row}")
    endif()
  endforeach()
endforeach()

function(expect_failure expected)
  execute_process(COMMAND "${BENCH}" ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${result}" MATCHES "^[0-9]+$" OR "${result}" STREQUAL "0" OR NOT err MATCHES "${expected}")
    message(FATAL_ERROR "benchmark failed to reject ${ARGN}: ${result}: ${out}: ${err}")
  endif()
endfunction()
expect_failure("paths must differ" "${work}/train.txt" "${work}/train.txt" "${work}/held-b.txt" 4)
expect_failure("must differ byte-for-byte" "${work}/train.txt" "${work}/copy.txt" "${work}/held-b.txt" 4)
expect_failure("invalid chunk" "${work}/train.txt" "${work}/held-a.txt" "${work}/held-b.txt" 0)
expect_failure("invalid learning rate" "${work}/train.txt" "${work}/held-a.txt" "${work}/held-b.txt" 4 0)
expect_failure("invalid candidate learning rate" "${work}/train.txt" "${work}/held-a.txt" "${work}/held-b.txt" 4 6000 small 0)
expect_failure("shape must" "${work}/train.txt" "${work}/held-a.txt" "${work}/held-b.txt" 4 6000 bad)
expect_failure("too short" "${work}/short.txt" "${work}/held-a.txt" "${work}/held-b.txt" 4)
expect_failure("empty sentence evaluation" "${work}/train.txt" "${work}/no-transitions.txt" "${work}/held-b.txt" 4)
expect_failure("cannot (open|inspect)" "${work}/missing.txt" "${work}/held-a.txt" "${work}/held-b.txt" 4)
expect_failure("invalid or overlong argument" "${work}/train.txt " "${work}/held-a.txt" "${work}/held-b.txt" 4)
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
  find_program(mkfifo_program mkfifo)
  if(mkfifo_program)
    execute_process(COMMAND "${mkfifo_program}" "${work}/train.fifo" RESULT_VARIABLE fifo_result)
    if("${fifo_result}" STREQUAL "0")
      execute_process(COMMAND "${BENCH}" "${work}/train.fifo" "${work}/held-a.txt" "${work}/held-b.txt" 4
        TIMEOUT 5 RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
      if(NOT "${result}" MATCHES "^[0-9]+$" OR "${result}" STREQUAL "0" OR
         NOT err MATCHES "benchmark corpus size invalid")
        message(FATAL_ERROR "FIFO benchmark input was accepted or blocked: ${result}: ${out}: ${err}")
      endif()
    endif()
  endif()
endif()
file(REMOVE_RECURSE "${work}")
message(STATUS "natural quality benchmark preserves equal-rate results and cold-record denominators")
