# SPDX-License-Identifier: MIT
# The byte model may emit non-UTF-8, but all JSON output remains valid and
# carries its original bytes. Probe text and scoring must not be truncated.
cmake_policy(SET CMP0054 NEW)
if(NOT DEFINED ENGINE OR NOT DEFINED FIXTURE OR NOT DEFINED WORK_ROOT)
  message(FATAL_ERROR "ENGINE, FIXTURE and WORK_ROOT are required")
endif()
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef nonce)
set(work "${WORK_ROOT}/native-prompt-json-${nonce}")
file(MAKE_DIRECTORY "${work}")
foreach(token IN ITEMS a ff c3 e0 ed f0 f4 huge overflow)
  execute_process(COMMAND "${FIXTURE}" "force-${token}" "${work}/${token}.vgfb" 6
    RESULT_VARIABLE result ERROR_VARIABLE err)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "cannot create ${token} fixture: ${result}: ${err}")
  endif()
endforeach()

# Decode the actual JSON with CMake's parser, including control bytes, quotes,
# backslashes and meaningful spaces at the end of the prompt.
string(ASCII 9 tab)
set(prompt "x${tab}\"\\  ")
execute_process(COMMAND "${ENGINE}" ask --checkpoint "${work}/a.vgfb" --prompt "${prompt}"
  --max-new 1 --temperature 0.1 RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT "${result}" STREQUAL "0")
  message(FATAL_ERROR "escaped ask failed: ${result}: ${out}: ${err}")
endif()
string(LENGTH "PROMPT_RESPONSE_JSON " prefix_length)
string(SUBSTRING "${out}" ${prefix_length} -1 json)
string(JSON decoded ERROR_VARIABLE json_error GET "${json}" prompt)
if(NOT json_error STREQUAL "NOTFOUND" OR NOT decoded STREQUAL prompt)
  message(FATAL_ERROR "ask prompt did not round-trip as valid JSON: ${out}: ${json_error}")
endif()
string(JSON answer GET "${json}" response)
string(JSON utf8 GET "${json}" response_valid_utf8)
string(JSON hex GET "${json}" response_bytes_hex)
if(NOT answer STREQUAL "A" OR NOT utf8 OR NOT hex STREQUAL "41")
  message(FATAL_ERROR "valid ask output was not preserved: ${out}")
endif()
# The advertised prompt capacity is MAX_PROMPT, not the former 1024-byte
# shared path buffer. Fail before decoding when the actual limit is exceeded.
string(REPEAT "x" 1100 longer_prompt)
execute_process(COMMAND "${ENGINE}" ask --checkpoint "${work}/a.vgfb" --prompt "${longer_prompt}" --max-new 1
  RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT "${result}" STREQUAL "0")
  message(FATAL_ERROR "a valid 1100-byte prompt was rejected: ${result}: ${err}")
endif()
string(SUBSTRING "${out}" ${prefix_length} -1 json)
string(JSON decoded ERROR_VARIABLE json_error GET "${json}" prompt)
if(NOT json_error STREQUAL "NOTFOUND" OR NOT decoded STREQUAL longer_prompt)
  message(FATAL_ERROR "long prompt was not preserved: ${json_error}")
endif()
string(REPEAT "x" 8193 overlong_prompt)
execute_process(COMMAND "${ENGINE}" ask --checkpoint "${work}/a.vgfb" --prompt "${overlong_prompt}" --max-new 1
  RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT "${result}" MATCHES "^[0-9]+$" OR "${result}" STREQUAL "0" OR NOT err MATCHES "argument is too long")
  message(FATAL_ERROR "overlong prompt was not rejected: ${result}: ${out}: ${err}")
endif()

execute_process(COMMAND "${ENGINE}" ask --checkpoint "${work}/ff.vgfb" --prompt x --max-new 1
  --temperature 0.1 RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT "${result}" STREQUAL "0")
  message(FATAL_ERROR "non-UTF-8 ask failed: ${result}: ${out}: ${err}")
endif()
string(SUBSTRING "${out}" ${prefix_length} -1 json)
string(JSON answer_type ERROR_VARIABLE json_error TYPE "${json}" response)
string(JSON utf8 GET "${json}" response_valid_utf8)
string(JSON hex GET "${json}" response_bytes_hex)
if(NOT json_error STREQUAL "NOTFOUND" OR NOT answer_type STREQUAL "NULL" OR utf8 OR NOT hex STREQUAL "ff")
  message(FATAL_ERROR "invalid model bytes were not represented losslessly: ${out}: ${json_error}")
endif()
string(JSON mode GET "${json}" text_output)
if(NOT mode STREQUAL "bytes")
  message(FATAL_ERROR "legacy output must default to raw bytes: ${out}")
endif()

# Opt-in text generation masks invalid leads and never starts a codepoint it
# cannot finish, in both greedy and sampled modes. The raw mode stays intact.
foreach(token IN ITEMS ff c3 e0 ed f0 f4)
  foreach(temperature IN ITEMS 0 0.7)
    foreach(max_new IN ITEMS 1 2 3 4)
      execute_process(COMMAND "${ENGINE}" ask --checkpoint "${work}/${token}.vgfb" --prompt x
        --text-output utf8 --max-new ${max_new} --temperature ${temperature} --seed 73
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
      if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "UTF-8 ${token}/${temperature}/${max_new} failed: ${result}: ${out}: ${err}")
      endif()
      string(SUBSTRING "${out}" ${prefix_length} -1 json)
      string(JSON answer_type ERROR_VARIABLE json_error TYPE "${json}" response)
      string(JSON utf8 GET "${json}" response_valid_utf8)
      string(JSON hex GET "${json}" response_bytes_hex)
      string(JSON mode GET "${json}" text_output)
      if(NOT json_error STREQUAL "NOTFOUND" OR NOT answer_type STREQUAL "STRING" OR NOT utf8 OR NOT mode STREQUAL "utf8")
        message(FATAL_ERROR "UTF-8 ${token}/${temperature}/${max_new} response invalid: ${out}: ${json_error}")
      endif()
      if(hex MATCHES "^ff")
        message(FATAL_ERROR "UTF-8 generation selected an invalid ff lead: ${out}")
      endif()
      if(token STREQUAL "c3" AND max_new EQUAL 2 AND NOT hex MATCHES "^c3[89ab][0-9a-f]$")
        message(FATAL_ERROR "two-byte scalar was not finished: ${out}")
      elseif(token STREQUAL "e0" AND max_new EQUAL 3 AND NOT hex MATCHES "^e0[ab][0-9a-f][89ab][0-9a-f]$")
        message(FATAL_ERROR "E0 overlong range was not excluded: ${out}")
      elseif(token STREQUAL "ed" AND max_new EQUAL 3 AND NOT hex MATCHES "^ed[89][0-9a-f][89ab][0-9a-f]$")
        message(FATAL_ERROR "ED surrogate range was not excluded: ${out}")
      elseif(token STREQUAL "f0" AND max_new EQUAL 4 AND NOT hex MATCHES "^f0[9ab][0-9a-f][89ab][0-9a-f][89ab][0-9a-f]$")
        message(FATAL_ERROR "F0 overlong range was not excluded: ${out}")
      elseif(token STREQUAL "f4" AND max_new EQUAL 4 AND NOT hex MATCHES "^f48[0-9a-f][89ab][0-9a-f][89ab][0-9a-f]$")
        message(FATAL_ERROR "F4 out-of-range scalar was not excluded: ${out}")
      endif()
    endforeach()
  endforeach()
endforeach()

foreach(temperature IN ITEMS 1e-310 1e308)
  execute_process(COMMAND "${ENGINE}" ask --checkpoint "${work}/a.vgfb" --prompt x --max-new 4
    --text-output utf8 --temperature ${temperature} --seed 9223372036854775807
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "extreme-temperature UTF-8 sampling failed: ${result}: ${out}: ${err}")
  endif()
  string(SUBSTRING "${out}" ${prefix_length} -1 json)
  string(JSON utf8 ERROR_VARIABLE json_error GET "${json}" response_valid_utf8)
  if(NOT json_error STREQUAL "NOTFOUND" OR NOT utf8)
    message(FATAL_ERROR "extreme-temperature output is not valid UTF-8: ${out}")
  endif()
endforeach()

execute_process(COMMAND "${ENGINE}" ask --checkpoint "${work}/ff.vgfb" --prompt x --max-new 1
  --text-output bytes RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
string(SUBSTRING "${out}" ${prefix_length} -1 json)
string(JSON hex ERROR_VARIABLE json_error GET "${json}" response_bytes_hex)
if(NOT "${result}" STREQUAL "0" OR NOT json_error STREQUAL "NOTFOUND" OR NOT hex STREQUAL "ff")
  message(FATAL_ERROR "explicit raw decoder lost compatibility: ${result}: ${out}: ${err}")
endif()
execute_process(COMMAND "${ENGINE}" ask --text-output unicode RESULT_VARIABLE result ERROR_VARIABLE err)
if("${result}" STREQUAL "0" OR NOT err MATCHES "--text-output must be bytes or utf8")
  message(FATAL_ERROR "invalid output mode was not rejected: ${result}: ${err}")
endif()
execute_process(COMMAND "${ENGINE}" train --text-output utf8 RESULT_VARIABLE result ERROR_VARIABLE err)
if("${result}" STREQUAL "0" OR NOT err MATCHES "only valid for ask or probe")
  message(FATAL_ERROR "output mode incorrectly affected training: ${result}: ${err}")
endif()

# A final record without a newline and trailing spaces in both TSV fields must
# survive parsing, rendering and the teacher-forced metric denominator.
file(WRITE "${work}/spaces.tsv" "fact\tx ü  \tA  ")
foreach(token IN ITEMS a ff)
  execute_process(COMMAND "${ENGINE}" probe --checkpoint "${work}/${token}.vgfb" --probe "${work}/spaces.tsv"
    --max-new 1 --temperature 0.1 RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "${token} probe failed: ${result}: ${out}: ${err}")
  endif()
  string(LENGTH "PROBE_EXAMPLES " examples_prefix)
  string(FIND "${out}" "\nPROBE_JSON " summary_at)
  if(summary_at LESS 0)
    message(FATAL_ERROR "probe summary missing: ${out}")
  endif()
  math(EXPR examples_length "${summary_at} - ${examples_prefix}")
  string(SUBSTRING "${out}" ${examples_prefix} ${examples_length} examples)
  string(JSON probe_prompt ERROR_VARIABLE json_error GET "${examples}" 0 prompt)
  string(JSON expected GET "${examples}" 0 expected)
  if(NOT json_error STREQUAL "NOTFOUND" OR NOT probe_prompt STREQUAL "x ü  " OR NOT expected STREQUAL "A  ")
    message(FATAL_ERROR "probe fields lost bytes or invalid JSON: ${out}: ${json_error}")
  endif()
  string(JSON response_type TYPE "${examples}" 0 response)
  string(JSON response_hex GET "${examples}" 0 response_bytes_hex)
  string(JSON greedy_type TYPE "${examples}" 0 greedy)
  string(JSON greedy_hex GET "${examples}" 0 greedy_bytes_hex)
  if(token STREQUAL "ff")
    if(NOT response_type STREQUAL "NULL" OR NOT response_hex STREQUAL "ff" OR
       NOT greedy_type STREQUAL "NULL" OR NOT greedy_hex STREQUAL "ffffff")
      message(FATAL_ERROR "invalid probe bytes were not preserved: ${out}")
    endif()
  else()
    if(NOT response_type STREQUAL "STRING" OR NOT response_hex STREQUAL "41" OR
       NOT greedy_type STREQUAL "STRING" OR NOT greedy_hex STREQUAL "414141")
      message(FATAL_ERROR "valid probe bytes were not preserved: ${out}")
    endif()
  endif()
  math(EXPR summary_start "${summary_at} + 1")
  string(SUBSTRING "${out}" ${summary_start} -1 summary)
  string(LENGTH "PROBE_JSON " summary_prefix)
  string(SUBSTRING "${summary}" ${summary_prefix} -1 summary_json)
  string(JSON rows GET "${summary_json}" rows)
  string(JSON truncated GET "${summary_json}" truncated)
  string(JSON exact GET "${summary_json}" fact correct)
  string(JSON correct_bytes GET "${summary_json}" fact correct_bytes)
  string(JSON total_bytes GET "${summary_json}" fact total_bytes)
  if(NOT rows EQUAL 1 OR truncated OR NOT exact EQUAL 0 OR NOT total_bytes EQUAL 3)
    message(FATAL_ERROR "probe row or exact-match accounting is wrong: ${out}")
  endif()
  if(token STREQUAL "a" AND NOT correct_bytes EQUAL 1)
    message(FATAL_ERROR "trailing expected bytes were not scored: ${out}")
  endif()
endforeach()

# The new free-generation policy must not alter teacher-forced byte/NLL
# scoring. In this fixture raw greedy bytes are deliberately invalid.
set(raw_nll "")
foreach(mode IN ITEMS bytes utf8)
  execute_process(COMMAND "${ENGINE}" probe --checkpoint "${work}/ff.vgfb" --probe "${work}/spaces.tsv"
    --max-new 1 --temperature 0.1 --text-output ${mode}
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "${mode} probe failed: ${result}: ${out}: ${err}")
  endif()
  string(FIND "${out}" "\nPROBE_JSON " summary_at)
  math(EXPR examples_length "${summary_at} - ${examples_prefix}")
  string(SUBSTRING "${out}" ${examples_prefix} ${examples_length} examples)
  string(JSON greedy_hex GET "${examples}" 0 greedy_bytes_hex)
  string(JSON response_type TYPE "${examples}" 0 response)
  if(NOT greedy_hex STREQUAL "ffffff")
    message(FATAL_ERROR "${mode} changed raw teacher-forced greedy scoring: ${out}")
  endif()
  if(mode STREQUAL "utf8" AND NOT response_type STREQUAL "STRING")
    message(FATAL_ERROR "UTF-8 probe response is not text: ${out}")
  endif()
  math(EXPR summary_start "${summary_at} + 1")
  string(SUBSTRING "${out}" ${summary_start} -1 summary)
  string(SUBSTRING "${summary}" ${summary_prefix} -1 summary_json)
  string(JSON current_nll GET "${summary_json}" fact mean_nll)
  string(JSON report_mode GET "${summary_json}" text_output)
  string(JSON valid_count GET "${summary_json}" valid_utf8_responses)
  string(JSON invalid_count GET "${summary_json}" invalid_utf8_responses)
  string(JSON empty_count GET "${summary_json}" empty_responses)
  if(NOT report_mode STREQUAL mode)
    message(FATAL_ERROR "probe did not report output mode: ${out}")
  endif()
  if(mode STREQUAL "bytes")
    if(NOT valid_count EQUAL 0 OR NOT invalid_count EQUAL 1 OR NOT empty_count EQUAL 0)
      message(FATAL_ERROR "raw probe UTF-8 counts are wrong: ${out}")
    endif()
    set(raw_nll "${current_nll}")
  elseif(NOT valid_count EQUAL 1 OR NOT invalid_count EQUAL 0)
    message(FATAL_ERROR "constrained probe UTF-8 counts are wrong: ${out}")
  elseif(NOT current_nll STREQUAL raw_nll)
    message(FATAL_ERROR "UTF-8 output changed teacher-forced NLL: ${out}")
  endif()
endforeach()

# Large finite NLL must use a compact JSON number, rather than overflowing an
# internal fixed-decimal record. Unrepresentable sums must fail normally before
# addition, with FPE traps enabled as well as in Release.
file(WRITE "${work}/large.tsv" "fact\tx\tB\n")
execute_process(COMMAND "${ENGINE}" probe --checkpoint "${work}/huge.vgfb" --probe "${work}/large.tsv" --max-new 1
  RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT "${result}" STREQUAL "0")
  message(FATAL_ERROR "large finite probe NLL failed: ${result}: ${out}: ${err}")
endif()
string(FIND "${out}" "\nPROBE_JSON " summary_at)
math(EXPR summary_start "${summary_at} + 1")
string(SUBSTRING "${out}" ${summary_start} -1 summary)
string(LENGTH "PROBE_JSON " summary_prefix)
string(SUBSTRING "${summary}" ${summary_prefix} -1 summary_json)
string(JSON nll ERROR_VARIABLE json_error GET "${summary_json}" fact mean_nll)
if(NOT json_error STREQUAL "NOTFOUND" OR NOT nll GREATER 1e99)
  message(FATAL_ERROR "large finite NLL is not valid JSON: ${out}: ${json_error}")
endif()
foreach(mode IN ITEMS within-row across-rows)
  if(mode STREQUAL "within-row")
    file(WRITE "${work}/${mode}.tsv" "fact\tx\tBB\n")
  else()
    file(WRITE "${work}/${mode}.tsv" "fact\tx\tB\nfact\tx\tB\n")
  endif()
  execute_process(COMMAND "${ENGINE}" probe --checkpoint "${work}/overflow.vgfb" --probe "${work}/${mode}.tsv"
    --max-new 1 RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${result}" MATCHES "^[0-9]+$" OR "${result}" STREQUAL "0" OR
     NOT err MATCHES "probe loss sum is not representable")
    message(FATAL_ERROR "${mode} probe overflow was not rejected normally: ${result}: ${out}: ${err}")
  endif()
endforeach()

function(expect_bad_probe name text expected_message)
  file(WRITE "${work}/${name}.tsv" "${text}")
  execute_process(COMMAND "${ENGINE}" probe --checkpoint "${work}/a.vgfb" --probe "${work}/${name}.tsv"
    --max-new 1 RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${result}" MATCHES "^[0-9]+$" OR "${result}" STREQUAL "0" OR NOT err MATCHES "${expected_message}")
    message(FATAL_ERROR "bad probe ${name} was not rejected: ${result}: ${out}: ${err}")
  endif()
endfunction()
expect_bad_probe(unknown "other\tx\tA\n" "malformed or overlong")
expect_bad_probe(missing "fact\tx\n" "malformed or overlong")
expect_bad_probe(extra "fact\tx\tA\textra\n" "malformed or overlong")
string(REPEAT "A" 257 overlong_expected)
expect_bad_probe(long_expected "fact\tx\t${overlong_expected}\n" "malformed or overlong")
string(REPEAT "A" 4200 overlong_line)
expect_bad_probe(long_line "fact\tx\t${overlong_line}\n" "probe line is too long")
string(ASCII 255 invalid_byte)
expect_bad_probe(invalid_utf8 "fact\tx\t${invalid_byte}\n" "probe row is not valid UTF-8")

# The engine scores at most 4096 rows; a further data row must be visible as
# truncation rather than being presented as a complete probe set.
string(REPEAT "fact\tx\tA\n" 4097 many_rows)
file(WRITE "${work}/limit.tsv" "${many_rows}")
execute_process(COMMAND "${ENGINE}" probe --checkpoint "${work}/a.vgfb" --probe "${work}/limit.tsv" --max-new 1
  RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT "${result}" STREQUAL "0" OR NOT out MATCHES "\"rows\": 4096" OR NOT out MATCHES "\"truncated\": true")
  message(FATAL_ERROR "probe row limit was not reported: ${result}: ${out}: ${err}")
endif()
file(REMOVE_RECURSE "${work}")
message(STATUS "native prompt JSON, byte fidelity and probe contracts passed")
